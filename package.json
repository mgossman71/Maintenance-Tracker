{
	"name": "maintenance-tracker",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"engines": {
		"bun": "1.4.4"
	},
	"scripts": {
		"dev": "bun run --parallel --filter './apps/*' dev",
		"typecheck": "bun run --filter '*' typecheck",
		"build": "bun run --filter '@mt/web' build",
		"test": "bun test",
		"e2e": "playwright test",
		"format": "biome check --write .",
		"db:generate": "bun run --filter '@mt/db' db:generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@playwright/test": "^1.56.1",
		"@types/bun": "1.4.4",
		"typescript": "^5.9.3"
	}
}

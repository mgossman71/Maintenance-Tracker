# Maintenance Tracker configuration — copy to .env and adjust.
# All values below are the defaults; every variable is optional.

# Network
MT_PORT=3000
# Inside Docker the container network is private; the reverse proxy provides HTTPS.
MT_BIND=0.0.0.0
# Set to 1 ONLY behind a trusted reverse proxy that terminates TLS: it relaxes
# the CSRF origin check to a hostname match. 0 = strict same-origin enforcement.
MT_TRUST_PROXY=1

# Storage (mount a persistent volume at this path in Docker)
MT_DATA_DIR=/data

# Sessions
MT_SESSION_IDLE_DAYS=30
MT_SESSION_MAX_DAYS=180

# Uploads: server-side enforced maximum per file
MT_MAX_UPLOAD_MB=10

# Timezone used for "today" in calendar due-date math
TZ=America/Chicago

# Cookies: set to 0 only for local development without HTTPS.
MT_SECURE_COOKIES=1

# Web frontend build location (default baked into the image)
# MT_WEB_DIST=/app/apps/web/dist

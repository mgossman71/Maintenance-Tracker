# Maintenance-Tracker — env config (build-plan.md §5)
# Every knob is an env var; no config files. Copy to .env or set in compose.

# Listen port (behind your TLS-terminating reverse proxy)
MT_PORT=8787

# Bind address. Keep loopback/private; the proxy is the front door.
# Inside Docker the compose file sets 0.0.0.0 on the container network.
MT_BIND=127.0.0.1

# Data directory: sqlite db + uploaded files live here. Never commit it.
MT_DATA_DIR=./data

# Set to 1 ONLY when a trusted reverse proxy fronts us (enables
# X-Forwarded-Proto / X-Forwarded-For handling).
MT_TRUST_PROXY=0

# Timezone used for month math / due dates (IANA name)
TZ=America/New_York
